{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "obsidian-learn-topic real-client observation",
  "type": "object",
  "required": ["client", "fresh_session", "case_id", "result", "evidence"],
  "properties": {
    "client": {"enum": ["codex", "claude"]},
    "fresh_session": {"const": true},
    "case_id": {"type": "string", "minLength": 1},
    "environment": {"enum": ["blank-vault", "similar-content", "stale-route", "no-safe-runner"]},
    "result": {"enum": ["passed", "failed", "not-verified", "blocked"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
