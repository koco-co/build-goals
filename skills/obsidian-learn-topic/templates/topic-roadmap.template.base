filters:
  and:
    - "file.ext == \"md\""
    - {{ROADMAP_FILTER_JSON}}
formulas:
  route_order: 'if(stage_order && lesson_order, stage_order * 100 + lesson_order, 0)'
  review_due: 'if(next_review, date(next_review) <= today(), false)'
  mastery_label: 'if(mastery_score >= 85, "稳固", if(mastery_score >= 60, "需巩固", "未掌握"))'
properties:
  formula.route_order:
    displayName: 路线序号
  file.name:
    displayName: 学习单元
  note.stage_title:
    displayName: 阶段
  note.difficulty:
    displayName: 难度
  note.learning_status:
    displayName: 学习状态
  note.roadmap_status:
    displayName: 主题状态
  note.repository_commit:
    displayName: 仓库 Commit
  note.core_slice:
    displayName: 核心切片
  note.upstream_status:
    displayName: 上游状态
  note.graduation_status:
    displayName: 毕业状态
  note.knowledge_points_total:
    displayName: 知识点总数
  note.knowledge_points_covered:
    displayName: 已验收知识点
  note.knowledge_points_pending:
    displayName: 待回答知识点
  note.coverage_status:
    displayName: 内容覆盖
  note.content_audit_note:
    displayName: 内容审计说明
  note.mastery_score:
    displayName: 掌握分
  note.mastery_evidence:
    displayName: 掌握证据
  note.assessment_type:
    displayName: 验收方式
  note.assessment_at:
    displayName: 验收时间
  formula.mastery_label:
    displayName: 掌握程度
  note.blocked_by:
    displayName: 阻塞项
  note.next_review:
    displayName: 下次复习
  note.last_reviewed:
    displayName: 上次复习
  note.review_count:
    displayName: 复习次数
  note.verified_at:
    displayName: 核验日期
  note.version_scope:
    displayName: 适用版本
  note.status:
    displayName: 内容状态
  file.mtime:
    displayName: 最近更新
views:
  - type: table
    name: 学习路线
    groupBy:
      property: note.stage_title
      direction: ASC
    sort:
      - property: formula.route_order
        direction: ASC
    order:
      - formula.route_order
      - file.name
      - note.difficulty
      - note.learning_status
      - note.roadmap_status
      - note.repository_commit
      - note.core_slice
      - note.upstream_status
      - note.graduation_status
      - note.knowledge_points_total
      - note.knowledge_points_covered
      - note.knowledge_points_pending
      - note.coverage_status
      - note.mastery_score
      - note.mastery_evidence
      - note.next_review
      - note.verified_at
      - note.version_scope
  - type: table
    name: 学习中
    filters:
      and:
        - 'learning_status == "学习中"'
    sort:
      - property: formula.route_order
        direction: ASC
    order:
      - formula.route_order
      - file.name
      - note.stage_title
      - note.mastery_score
      - note.knowledge_points_pending
      - note.coverage_status
      - file.mtime
  - type: table
    name: 阻塞
    filters:
      and:
        - 'learning_status == "阻塞"'
    sort:
      - property: formula.route_order
        direction: ASC
    order:
      - formula.route_order
      - file.name
      - note.blocked_by
      - file.mtime
  - type: table
    name: 待复习
    filters:
      and:
        - 'formula.review_due == true'
        - or:
            - 'learning_status == "已掌握"'
            - 'learning_status == "待复习"'
    sort:
      - property: note.next_review
        direction: ASC
    order:
      - formula.route_order
      - file.name
      - note.mastery_score
      - note.next_review
      - note.review_count
  - type: table
    name: 已掌握
    filters:
      and:
        - 'learning_status == "已掌握"'
        - 'status == "已发布"'
        - 'list(mastery_evidence).length > 0'
    sort:
      - property: formula.route_order
        direction: ASC
    order:
      - formula.route_order
      - file.name
      - note.mastery_score
      - note.mastery_evidence
      - note.assessment_type
      - note.assessment_at
      - note.last_reviewed
      - note.next_review
  - type: table
    name: 待核验
    filters:
      and:
        - 'status == "待核验"'
    sort:
      - property: formula.route_order
        direction: ASC
    order:
      - formula.route_order
      - file.name
      - note.verified_at
      - note.version_scope
  - type: table
    name: 待补齐
    filters:
      and:
        - 'coverage_status == "部分覆盖"'
    sort:
      - property: formula.route_order
        direction: ASC
    order:
      - formula.route_order
      - file.name
      - note.knowledge_points_pending
      - note.content_audit_note
      - file.mtime
