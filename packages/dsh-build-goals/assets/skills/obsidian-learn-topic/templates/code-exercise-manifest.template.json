{
  "schema_version": 2,
  "vault_root": "{{ABSOLUTE_EXISTING_VAULT_ROOT}}",
  "workspace_root": "{{USER_PROVIDED_CONFIRMED_EXISTING_EXTERNAL_ROOT}}",
  "exercise_directory": "01-{{EXERCISE_SLUG}}",
  "exercise": {
    "id": "{{TOPIC_ID}}-{{LESSON_ID}}-01",
    "version": 1,
    "topic": "{{TOPIC_DISPLAY}}",
    "lesson_id": "{{LESSON_ID}}",
    "title": "{{EXERCISE_TITLE}}",
    "language": "{{LANGUAGE}}",
    "version_scope": "{{VERSION_SCOPE}}",
    "goal": "{{ONE_VERIFIABLE_GOAL}}",
    "layout": "standalone",
    "core_requirements": ["{{PUBLIC_CORE_REQUIREMENT}}"],
    "explanation_prompts": ["{{EXPLAIN_KEY_IMPLEMENTATION_AND_BOUNDARY}}"],
    "rubric": {
      "mode": "pass-fail",
      "criteria": ["{{PUBLIC_PASS_CRITERION}}"]
    },
    "hints": [
      {"when": "首次失败后", "content": "{{FAILURE_AND_KNOWLEDGE_POINT}}"},
      {"when": "仍无法定位时", "content": "{{FILE_FUNCTION_OR_BOUNDARY_CLUE}}"}
    ]
  },
  "files": [
    {"path": "01-{{EXERCISE_SLUG}}.py", "role": "starter", "content_file": "starter.py", "user_editable": true},
    {"path": "test_exercise.py", "role": "core_test", "content_file": "test_exercise.py", "user_editable": false}
  ],
  "commands": [
    {
      "id": "core-test",
      "kind": "test",
      "argv": ["python3", "-m", "unittest", "-v", "test_exercise.py"],
      "cwd": ".",
      "env": {},
      "timeout_seconds": 30,
      "required": true,
      "visible": true,
      "effects": []
    }
  ]
}
