filters:
  and:
    - "file.ext == \"md\""
    - {{ROADMAP_FILTER_JSON}}
formulas:
  route_order: 'if(stage_order && lesson_order, stage_order * 100 + lesson_order, 0)'
  review_due: 'if(next_review, date(next_review) <= today(), false)'
properties:
  formula.route_order:
    displayName: 路线序号
  note.record_type:
    displayName: 记录层
  note.unit_id:
    displayName: 单元 ID
  note.progress_status:
    displayName: 学习进度
  note.mastery_status:
    displayName: 掌握证据等级
  note.evidence_profile:
    displayName: 证据类型
  note.mastery_evidence:
    displayName: 掌握证据
  note.next_review:
    displayName: 下次复习
views:
  - type: table
    name: 路线总览
    sort:
      - property: formula.route_order
        direction: ASC
    order:
      - formula.route_order
      - file.name
      - note.record_type
      - note.unit_id
      - note.progress_status
      - note.mastery_status
  - type: table
    name: 当前学习
    filters:
      and:
        - 'record_type == "learning-evidence"'
        - 'progress_status == "学习中"'
    order:
      - formula.route_order
      - file.name
      - note.content_note
  - type: table
    name: 到期复习
    filters:
      and:
        - 'record_type == "learning-evidence"'
        - 'formula.review_due == true'
    sort:
      - property: note.next_review
        direction: ASC
    order:
      - file.name
      - note.mastery_status
      - note.next_review
  - type: table
    name: 阻塞项
    filters:
      and:
        - 'record_type == "learning-evidence"'
        - 'progress_status == "阻塞"'
    order:
      - file.name
      - note.blocked_by
  - type: table
    name: 能力证据
    filters:
      and:
        - 'record_type == "learning-evidence"'
        - 'mastery_status != ""'
    order:
      - file.name
      - note.evidence_profile
      - note.mastery_status
      - note.mastery_evidence
  - type: table
    name: 待核验
    filters:
      and:
        - 'record_type == "knowledge-note"'
        - 'status == "待核验"'
  - type: table
    name: 待补齐
    filters:
      and:
        - 'record_type == "knowledge-note"'
        - 'coverage_status == "部分覆盖"'
